{
  "name": "minii-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "prod": "npm run build && npm start",
    "preview": "vite preview",
    "lint": "oxlint src server",
    "backup": "node server/scripts/backup.js",
    "admin:password": "node server/scripts/set-admin-password.js"
  },
  "dependencies": {
    "concurrently": "^10.0.7",
    "express": "^5.3.0",
    "nodemailer": "^10.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=22.13"
  }
}
