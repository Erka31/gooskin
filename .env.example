# =====================================================================
#  Gooskin — тохиргоо. Энэ файлыг ".env" нэрээр хуулж утгуудаа бөглөнө:
#     cp .env.example .env
#  .env файлыг хэзээ ч Git-д оруулахгүй (нууц мэдээлэлтэй).
# =====================================================================

# ---------- Үндсэн ----------
NODE_ENV=production
PORT=3001
# Сайтын бүрэн хаяг (имэйлийн холбоос, QPay callback, SEO-д ашиглана)
PUBLIC_URL=https://gooskin.mn

# Токены нууц түлхүүр — 32+ тэмдэгт. Үүсгэх:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# https дээр true (production-д default true)
COOKIE_SECURE=true
# nginx-ийн ард бол 1 (production-д default 1)
TRUST_PROXY=1

# Анхны админ (зөвхөн админ огт байхгүй үед үүснэ).
# Дараа нь солих: npm run admin:password -- admin@gooskin.mn "ШинэНууцҮг"
ADMIN_EMAIL=admin@gooskin.mn
ADMIN_PASSWORD=

# ---------- Дэлгүүр ----------
SHOP_NAME=Gooskin
SHOP_PHONE=88094535

# ---------- Шинэ захиалгын мэдэгдэл: Telegram ----------
# 1) Telegram-д @BotFather → /newbot → токен авна
# 2) Ботдоо мессеж бичээд https://api.telegram.org/bot<ТОКЕН>/getUpdates -с chat.id-г авна
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Имэйл (нууц үг сэргээх, захиалгын баталгаа) ----------
# Gmail бол: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
#            SMTP_PASS = Google "App password" (энгийн нууц үг биш)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Gooskin <info@gooskin.mn>"
# Шинэ захиалга ирэхэд мэдэгдэл авах имэйл
ADMIN_NOTIFY_EMAIL=

# ---------- QPay (merchant гэрээ хийсний дараа QPay-ээс өгнө) ----------
# Туршилт: QPAY_BASE_URL=https://merchant-sandbox.qpay.mn/v2
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# ---------- Хадгалалт ба backup ----------
# DB_PATH=/var/lib/gooskin/shop.db
# UPLOAD_DIR=/var/lib/gooskin/uploads
# BACKUP_DIR=/var/backups/gooskin
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
