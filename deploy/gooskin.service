# pm2-ийн оронд systemd ашиглах бол: /etc/systemd/system/gooskin.service
#   sudo systemctl enable --now gooskin
[Unit]
Description=Gooskin shop
After=network.target

[Service]
Type=simple
User=gooskin
WorkingDirectory=/srv/gooskin
ExecStart=/usr/bin/node server/index.js
Environment=NODE_ENV=production
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
